{
  "name": "astro-edgekits-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdgeKits/astro-edgekits-core.git"
  },
  "type": "module",
  "private": true,
  "version": "3.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "cloudflare": {
    "bindings": {
      "TRANSLATIONS": {
        "description": "A KV namespace to store translations."
      }
    },
    "vars": {
      "I18N_CACHE": {
        "description": "on/off"
      },
      "DEBUG_I18N": {
        "description": "on/off"
      },
      "DEMO_MODE": {
        "description": "on/off"
      },
      "CLOUDFLARE_ZONE_ID": {
        "description": "your cloudflare zone id string"
      }
    }
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typegen": "wrangler types",
    "setup": "node scripts/setup.mjs",
    "i18n:bundle": "edgekits-i18n bundle",
    "i18n:seed": "edgekits-i18n seed",
    "i18n:migrate": "edgekits-i18n migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@edgekits/astro-i18n": "^0.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.151.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "flag-icons": "^7.5.0",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
