/**
 * Wrangler configuration:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astro-edgekits-core",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // Values here apply to `wrangler dev` and deployments. `astro dev` reads
  // overrides from .dev.vars (copy .dev.vars.example, or run `npm run setup`).
  "vars": {
    "I18N_CACHE": "on",
    "DEBUG_I18N": "off",
    "DEMO_MODE": "on",
    "CLOUDFLARE_ZONE_ID": "your_cf_zone_id_here",
  },
  // Placeholder ids (32 hex characters): local development needs no Cloudflare
  // account. Replace both with your namespace id before `i18n:migrate` or deploy.
  "kv_namespaces": [
    {
      "binding": "TRANSLATIONS",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000",
    },
  ],
}
