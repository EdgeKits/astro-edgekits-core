---
import { actions, isInputError } from 'astro:actions'
import type { Locale } from '@edgekits/astro-i18n/runtime'

import { isErrorMessageCode } from '@/domain/messages'

interface Props {
  t: Pick<I18n.Schema, 'newsletter' | 'messages'>
  locale: Locale
}

const { t, locale } = Astro.props
const { newsletter, messages } = t

// Every code the form can receive -> its text in this locale.
const tErrors: Record<string, string> = { ...messages.errors.ui, ...messages.errors.server }

// No-JS: with JS this result is null (the submit is intercepted); without JS the native
// POST runs the action and this render shows its result and the inline errors.
const result = Astro.getActionResult(actions.newsletter.subscribe)
const sent = Boolean(result && !result.error && result.data)
const noJsError = (field: 'email' | 'consent') => {
  const code = result?.error && isInputError(result.error) ? result.error.fields[field]?.[0] : undefined
  return code ? (tErrors[code] ?? '') : ''
}
const noJsFormError =
  result?.error && !isInputError(result.error)
    ? result.error.code === 'BAD_REQUEST' && isErrorMessageCode(result.error.message)
      ? (tErrors[result.error.message] ?? messages.errors.server.INTERNAL_SERVER_ERROR)
      : messages.errors.server.INTERNAL_SERVER_ERROR
    : ''

// Strings the client controller needs, already localized (no translation file ships).
const clientConfig = { tErrors }
const errorClass = 'text-sm font-normal text-red-600'
---

<div class="mx-auto w-full max-w-md">
  <p data-newsletter-success role="status" hidden={!sent} class="rounded-lg bg-emerald-50 px-4 py-3 text-emerald-800">
    {messages.common.SUBSCRIPTION_SUCCEED}
  </p>
  {
    !sent && (
      <form
        method="POST"
        action={actions.newsletter.subscribe}
        data-newsletter-form
        data-config={JSON.stringify(clientConfig)}
        novalidate
        class="flex flex-col gap-5 text-left"
      >
        <input type="hidden" name="locale" value={locale} />

        <div role="group" data-slot="field" class="flex flex-col gap-2">
          <label for="newsletter-email" class="text-sm font-medium">
            {newsletter.emailLabel}
          </label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder={newsletter.placeholder}
            aria-invalid={noJsError('email') ? 'true' : undefined}
            class="rounded-lg border border-zinc-300 px-3 py-2 outline-none focus:border-zinc-900 aria-invalid:border-red-500"
          />
          <div
            data-error-for="email"
            class={noJsError('email') ? errorClass : ''}
            role={noJsError('email') ? 'alert' : undefined}
            hidden={!noJsError('email')}
          >
            {noJsError('email')}
          </div>
        </div>

        <div role="group" data-slot="field" class="flex flex-col gap-2">
          <label class="flex items-start gap-3 text-sm text-zinc-700">
            <input
              name="consent"
              type="checkbox"
              aria-invalid={noJsError('consent') ? 'true' : undefined}
              class="mt-0.5 size-4 accent-zinc-900"
            />
            <span>{newsletter.consent}</span>
          </label>
          <div
            data-error-for="consent"
            class={noJsError('consent') ? errorClass : ''}
            role={noJsError('consent') ? 'alert' : undefined}
            hidden={!noJsError('consent')}
          >
            {noJsError('consent')}
          </div>
        </div>

        <div
          data-error-for="_form"
          class={noJsFormError ? errorClass : ''}
          role={noJsFormError ? 'alert' : undefined}
          hidden={!noJsFormError}
        >
          {noJsFormError}
        </div>

        <button
          type="submit"
          class="rounded-lg bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-zinc-700 disabled:cursor-not-allowed disabled:opacity-50"
        >
          <span data-pending-hide>{newsletter.button}</span>
          <span data-pending-show>{messages.common.PENDING}…</span>
        </button>
        <p class="text-xs text-zinc-500">{newsletter.demoNote}</p>
      </form>
    )
  }
</div>

<style>
  [data-pending-show] {
    display: none;
  }
  [data-newsletter-form][data-pending] [data-pending-hide] {
    display: none;
  }
  [data-newsletter-form][data-pending] [data-pending-show] {
    display: inline;
  }
</style>

<script>
  import { actions } from 'astro:actions'

  import { enhanceForm } from '@/ui/forms/enhance'
  import { fail, isEmail, ok, str, type ClientSchema, type SchemaIssue } from '@/ui/forms/client-schema'
  import { ERROR_MESSAGE_CODES } from '@/domain/messages/error-codes'
  import { isErrorMessageCode } from '@/domain/messages/guards'

  interface NewsletterConfig {
    tErrors: Record<string, string>
  }

  // Hand-rolled mirror of NewsletterSchema (src/domain/newsletter/schema.ts): same fields,
  // same CODES. No zod in the browser. `type`, not `interface`: enhanceForm needs the
  // implicit index signature of a type alias.
  type NewsletterValues = {
    email: string
    consent: boolean
  }

  const ClientNewsletterSchema: ClientSchema<NewsletterValues> = {
    safeParse(values) {
      const v = (values ?? {}) as Record<string, unknown>
      const issues: SchemaIssue[] = []
      const email = str(v.email).trim()
      // An unchecked checkbox is absent from FormData.
      const consent = v.consent != null
      if (!email) issues.push({ path: ['email'], message: ERROR_MESSAGE_CODES.REQUIRED })
      else if (!isEmail(email)) issues.push({ path: ['email'], message: ERROR_MESSAGE_CODES.INVALID_EMAIL })
      if (!consent) issues.push({ path: ['consent'], message: ERROR_MESSAGE_CODES.CONSENT_REQUIRED })
      if (issues.length > 0) return fail(issues)
      return ok({ email, consent })
    },
  }

  function initNewsletterForms(): void {
    document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
      if (form.dataset.enhanced) return
      form.dataset.enhanced = 'true'

      const config = JSON.parse(form.dataset.config ?? '{}') as NewsletterConfig
      const localeInput = form.elements.namedItem('locale')
      const locale = localeInput instanceof HTMLInputElement ? localeInput.value : ''
      const success = form.parentElement?.querySelector<HTMLElement>('[data-newsletter-success]')

      enhanceForm<NewsletterValues, { ok: true }>(form, ClientNewsletterSchema, actions.newsletter.subscribe, {
        tErrors: config.tErrors,
        // The action accepts FormData (it also serves the no-JS POST).
        transform: (values) => {
          const data = new FormData()
          data.set('email', values.email)
          if (values.consent) data.set('consent', 'on')
          data.set('locale', locale)
          return data
        },
        onSuccess: () => {
          form.hidden = true
          if (success) success.hidden = false
        },
        onActionError: (error, helpers) => {
          const code =
            error.code === 'BAD_REQUEST' && error.message && isErrorMessageCode(error.message)
              ? error.message
              : ERROR_MESSAGE_CODES.INTERNAL_SERVER_ERROR
          helpers.setFormError(code)
        },
      })
    })
  }

  initNewsletterForms()
  document.addEventListener('astro:page-load', initNewsletterForms)
</script>
